# .env.example — copy to .env and fill in. NEVER commit .env.
#
# Credentials and deployment overrides live here; everything else lives in
# config/*.yaml. The split is deliberate: YAML is committed and reviewable,
# .env is not. A secret must never appear in a YAML file.

# ---------------------------------------------------------------------------
# OpenBB transport
# ---------------------------------------------------------------------------
# Overrides config/settings.yaml -> openbb.local_api_base_url.
# Point this at a remote OpenBB API instance to avoid running one locally.
# OPENBB_API_URL=http://127.0.0.1:6900

# Set to 1 to bypass the local API and always use the Python package path.
# Useful for isolating which path is broken when a series fails to fetch.
# OPENBB_USE_PACKAGE_ONLY=1

# ---------------------------------------------------------------------------
# Data providers
# ---------------------------------------------------------------------------
# FRED REQUIRES A KEY. The previous note here said "FRED is reachable without a
# key" — that is wrong, and it was measured wrong on 2026-09-19: the engine
# fetches through openbb-fred, which calls the official
# https://api.stlouisfed.org/fred/series/observations endpoint. Verified live:
#   valid key   -> HTTP 200 with real observations
#   bogus key   -> HTTP 400 "The value for variable api_key is not registered."
# There is no keyless fallback path in this codebase.
#
# All 45 registry series use the `fred` provider, so this single key covers the
# whole data layer.
#
# WHERE THE KEY ACTUALLY COMES FROM (measured 2026-09-19). The engine does not
# read this variable itself — it calls obb.economy.fred_series(...), and the
# openbb package resolves the key from ITS OWN credential store:
#
#     ~/.openbb_platform/user_settings.json   ->  {"credentials": {"fred_api_key": "..."}}
#
# That is the same store OpenBB Desktop writes to, so a key configured in the
# OpenBB Desktop application IS picked up here with no further wiring. A
# `FRED_API_KEY=` line in this .env is still worth setting as an explicit,
# committed-instructions record of the dependency — and it is the only thing
# that would let a future non-OpenBB fetch path work — but it is not what makes
# the current fetches succeed.
#
# If a fetch fails with HTTP 400 "api_key is not registered", the fix is in
# ~/.openbb_platform/user_settings.json, NOT in this file.
# FRED_API_KEY=

# ---------------------------------------------------------------------------
# Storage & logging
# ---------------------------------------------------------------------------
# Overrides config/settings.yaml -> data.raw_store_path.
# MACRO_RAW_STORE_PATH=data/raw

# Overrides config/logging.yaml level. JSON lines either way.
# MACRO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API layer (Phase 3+)
# ---------------------------------------------------------------------------
# Section 8.4 mandates local-only binding. Overriding this to a public
# interface exposes a service that has no authentication by design.
# MACRO_API_HOST=127.0.0.1
# MACRO_API_PORT=8000
