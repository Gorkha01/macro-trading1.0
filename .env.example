# .env.example — copy to .env and fill in. NEVER commit .env.
#
# Credentials and deployment overrides live here; everything else lives in
# config/*.yaml. The split is deliberate: YAML is committed and reviewable,
# .env is not. A secret must never appear in a YAML file.

# ---------------------------------------------------------------------------
# OpenBB transport
# ---------------------------------------------------------------------------
# Overrides config/settings.yaml -> openbb.local_api_base_url.
# Point this at a remote OpenBB API instance to avoid running one locally.
# OPENBB_API_URL=http://127.0.0.1:6900

# Set to 1 to bypass the local API and always use the Python package path.
# Useful for isolating which path is broken when a series fails to fetch.
# OPENBB_USE_PACKAGE_ONLY=1

# ---------------------------------------------------------------------------
# Data providers
# ---------------------------------------------------------------------------
# FRED is reachable without a key, but a key raises the rate limit
# substantially. A full US snapshot pulls ~50 series; without a key those
# requests will be throttled on repeated runs.
# FRED_API_KEY=

# ---------------------------------------------------------------------------
# Storage & logging
# ---------------------------------------------------------------------------
# Overrides config/settings.yaml -> data.raw_store_path.
# MACRO_RAW_STORE_PATH=data/raw

# Overrides config/logging.yaml level. JSON lines either way.
# MACRO_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# API layer (Phase 3+)
# ---------------------------------------------------------------------------
# Section 8.4 mandates local-only binding. Overriding this to a public
# interface exposes a service that has no authentication by design.
# MACRO_API_HOST=127.0.0.1
# MACRO_API_PORT=8000
